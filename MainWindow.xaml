<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Seniority_calculator.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" Title="Стаж // Компенсация">
    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="01. Расчет трудового стажа" FontSize="20" Margin="0,0,0,10"/>
        <!-- ФИО -->
        <TextBox x:Name="FullNameTextBox" Grid.Row="1" Grid.ColumnSpan="2" Header="ФИО" PlaceholderText="Введите ФИО" Height="56" Margin="0,0,0,6"/>
        <!-- Даты -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="StartPeriod" Grid.Column="0" Header="Дата приема" PlaceholderText="ДДММГГГГ" MaxLength="8" Height="56" KeyDown="StartPeriod_KeyDown"/>
            <TextBox x:Name="EndPeriod" Grid.Column="1" Header="Дата увольнения" PlaceholderText="ДДММГГГГ" MaxLength="8" Height="56" KeyDown="EndPeriod_KeyDown"/>
        </Grid>
        <!-- Прибавляемый стаж -->
        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="Прибавляемый стаж" FontSize="14" Margin="0,8,0,4"/>
        <!-- Годы / месяцы / дни -->
        <Grid Grid.Row="4" Grid.ColumnSpan="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="AddedSeniorityYears" Grid.Column="0" Header="Года" MaxLength="4" Height="56"/>
            <TextBox x:Name="AddedSeniorityMonths" Grid.Column="1" Header="Месяцы" MaxLength="2" Height="56"/>
            <TextBox x:Name="AddedSeniorityDays" Grid.Column="2" Header="Дни" MaxLength="2" Height="56"/>
        </Grid>
        <!-- Результат и кнопка -->
        <Grid Grid.Row="5" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Посчитать" Click="MyButton_Click" MinWidth="110" HorizontalAlignment="Left"/>
            <TextBlock x:Name="ResultTextBlock" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="15" TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</Window>