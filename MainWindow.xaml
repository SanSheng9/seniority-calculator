<?xml version="1.0" encoding="utf-8"?>
    <Window
    x:Class="Seniority_calculator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Стаж // Компенсация">

    <StackPanel>

        <!-- Заголовок окна -->
        <TitleBar
            x:Name="AppTitleBar"
            Title="Расчет трудового стажа">

            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xED28;"/>
            </TitleBar.IconSource>

        </TitleBar>


        <!-- Основное содержимое -->
        <Grid Padding="16">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- Заголовок раздела -->
            <TextBlock
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Text="01. Трудовой стаж"
                FontSize="20"
                Margin="0,0,0,12"/>


            <!-- ФИО -->
            <TextBox
                x:Name="FullNameTextBox"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Header="ФИО"
                PlaceholderText="Например, Иванов Иван Иванович"
                Height="56"
                Margin="0,0,0,8"/>


            <!-- Периоды работы -->
            <StackPanel
                x:Name="PeriodsPanel"
                Grid.Row="2"
                Grid.ColumnSpan="2"
                Spacing="4"
                Margin="0,0,0,8"/>


            <!-- Дополнительный стаж -->
            <TextBlock
                Grid.Row="3"
                Grid.ColumnSpan="2"
                Text="Прибавляемый стаж"
                FontSize="14"
                Margin="0,0,0,4"/>


            <!-- Годы / месяцы / дни -->
            <Grid
                Grid.Row="4"
                Grid.ColumnSpan="2"
                ColumnSpacing="8"
                Margin="0,0,0,8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>


                <!-- Годы -->
                <NumberBox
                    x:Name="AddedSeniorityYears"
                    Grid.Column="0"
                    Header="Годы"
                    Height="56"
                    Minimum="0"
                    SmallChange="1"
                    LargeChange="10"
                    SpinButtonPlacementMode="Compact"
                    ValidationMode="InvalidInputOverwritten"
                    ValueChanged="AddedSeniorityYearsChanged"/>


                <!-- Месяцы -->
                <NumberBox
                    x:Name="AddedSeniorityMonths"
                    Grid.Column="1"
                    Header="Месяцы"
                    Height="56"
                    Minimum="0"
                    Maximum="11"
                    SmallChange="1"
                    LargeChange="6"
                    SpinButtonPlacementMode="Compact"
                    ValidationMode="InvalidInputOverwritten"
                    ValueChanged="AddedSeniorityMonthsChanged"/>


                <!-- Дни -->
                <NumberBox
                    x:Name="AddedSeniorityDays"
                    Grid.Column="2"
                    Header="Дни"
                    Height="56"
                    Minimum="0"
                    Maximum="29"
                    SmallChange="1"
                    LargeChange="10"
                    SpinButtonPlacementMode="Compact"
                    ValidationMode="InvalidInputOverwritten"
                    ValueChanged="AddedSeniorityDaysChanged"/>

            </Grid>


            <!-- Итог -->
            <Border
                Grid.Row="5"
                Grid.ColumnSpan="2"
                Margin="0,4,0,0"
                Padding="12"
                CornerRadius="8">

                <StackPanel
                    Spacing="4">

                    <TextBlock
                        Text="Итоговый стаж"
                        FontSize="14"/>

                    <TextBlock
                        x:Name="FinalSeniority"
                        Text="0 лет, 0 месяцев, 0 дней"
                        FontSize="22"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"/>

                </StackPanel>

            </Border>

        </Grid>

    </StackPanel>

</Window>
